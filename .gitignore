# Evita subir a GitHub el archivo que contiene la clave de la API.
.env

# Evita subir los historiales personales generados por el chatbot.
conversacion_*.json

# Evita subir las carpetas de caché generadas por Python.
__pycache__/

# Evita subir archivos compilados de Python.
*.pyc

# Evita subir la caché temporal generada por pytest.
.pytest_cache/

# Evita publicar el progreso personal generado durante el uso.
nivel_experto/datos/progreso/*.json

# Evita preparar temporales si una escritura se interrumpe.
nivel_experto/datos/progreso/*.tmp

# Evita publicar los logs generados durante la ejecución.
nivel_experto/logs/*.log
nivel_experto/logs/*.log.*
